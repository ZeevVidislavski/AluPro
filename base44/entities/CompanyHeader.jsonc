      "description": "\u05db\u05d9\u05ea\u05d5\u05d1 \u05de\u05e9\u05e0\u05d4 (\u05d8\u05dc\u05e4\u05d5\u05df, \u05db\u05ea\u05d5\u05d1\u05ea \u05d5\u05db\u05d5')"
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d6\u05d5 \u05d4\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05d1\u05e8\u05d9\u05e8\u05ea \u05de\u05d7\u05d3\u05dc"
