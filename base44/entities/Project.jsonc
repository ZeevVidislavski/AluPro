{
  "name": "Project",
  "type": "object",
  "properties": {
    "project_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8"
    },
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8"
    },
    "customer_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05dc\u05e7\u05d5\u05d7"
    },
    "customer_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05dc\u05e7\u05d5\u05d7"
    },
    "address": {
      "type": "string",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8"
    },
    "aluminum_color": {
      "type": "string",
      "description": "\u05e6\u05d1\u05e2 \u05d0\u05dc\u05d5\u05de\u05d9\u05e0\u05d9\u05d5\u05dd"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e4\u05ea\u05d9\u05d7\u05d4"
    },
    "target_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d9\u05e2\u05d3"
    },
    "status": {
      "type": "string",
      "enum": [
        "quote",
        "negotiation",
        "approved",
        "ordering",
        "production",
        "installation",
        "completed",
        "invoiced"
      ],
      "enumLabels": [
        "\u05d1\u05d4\u05e6\u05e2\u05d4",
        "\u05de\u05d5\u05f4\u05de",
        "\u05de\u05d0\u05d5\u05e9\u05e8",
        "\u05d1\u05d4\u05d6\u05de\u05e0\u05ea \u05d7\u05d5\u05de\u05e8",
        "\u05d1\u05d9\u05d9\u05e6\u05d5\u05e8",
        "\u05d1\u05d4\u05ea\u05e7\u05e0\u05d4",
        "\u05d4\u05d5\u05e9\u05dc\u05dd",
        "\u05e1\u05d2\u05d5\u05e8 \u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea"
      ],
      "default": "quote",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8"
    },
    "initial_quote": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05d4\u05e6\u05e2\u05d4 \u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05ea"
    },
    "final_quote": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05d4\u05e6\u05e2\u05d4 \u05e1\u05d5\u05e4\u05d9"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05db\u05dc\u05dc\u05d9\u05d5\u05ea"
    },
    "settlement_status": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ],
      "enumLabels": [
        "\u05e4\u05ea\u05d5\u05d7",
        "\u05e1\u05d2\u05d5\u05e8"
      ],
      "default": "open",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05ea\u05d7\u05e9\u05d1\u05e0\u05d5\u05ea"
    },
    "closed_at": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e1\u05d2\u05d9\u05e8\u05ea \u05d4\u05ea\u05d7\u05e9\u05d1\u05e0\u05d5\u05ea"
    },
    "closed_by": {
      "type": "string",
      "description": "\u05de\u05d9 \u05e1\u05d2\u05e8 \u05d0\u05ea \u05d4\u05d4\u05ea\u05d7\u05e9\u05d1\u05e0\u05d5\u05ea"
    }
  },
  "required": [
    "name",
    "customer_id",
    "customer_name",
    "status"
  ]
}