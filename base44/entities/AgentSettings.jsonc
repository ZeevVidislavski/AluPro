{
  "name": "AgentSettings",
  "type": "object",
  "properties": {
    "minimum_profit_percent": {
      "type": "number",
      "default": 15,
      "description": "\u05d0\u05d7\u05d5\u05d6 \u05e8\u05d5\u05d5\u05d7 \u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05de\u05d5\u05de\u05dc\u05e5"
    },
    "cash_flow_warning_threshold": {
      "type": "number",
      "default": -50000,
      "description": "\u05e1\u05e3 \u05d0\u05d6\u05d4\u05e8\u05ea \u05ea\u05d6\u05e8\u05d9\u05dd \u05e9\u05dc\u05d9\u05dc\u05d9"
    },
    "max_open_projects": {
      "type": "number",
      "default": 10,
      "description": "\u05de\u05e1\u05e4\u05e8 \u05de\u05e7\u05e1\u05d9\u05de\u05dc\u05d9 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8\u05d9\u05dd \u05e4\u05e2\u05d9\u05dc\u05d9\u05dd"
    },
    "high_debt_threshold": {
      "type": "number",
      "default": 100000,
      "description": "\u05e1\u05e3 \u05d7\u05d5\u05d1 \u05d2\u05d1\u05d5\u05d4 \u05dc\u05d0\u05d6\u05d4\u05e8\u05d4"
    },
    "contractor_priority_weight": {
      "type": "number",
      "default": 1.5,
      "description": "\u05de\u05e9\u05e7\u05dc \u05e2\u05d3\u05d9\u05e4\u05d5\u05ea \u05dc\u05e7\u05d1\u05dc\u05e0\u05d9\u05dd"
    },
    "enable_morning_summary": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05e4\u05e2\u05dc \u05e1\u05d9\u05db\u05d5\u05dd \u05d1\u05d5\u05e7\u05e8"
    },
    "enable_realtime_alerts": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05e4\u05e2\u05dc \u05d4\u05ea\u05e8\u05d0\u05d5\u05ea \u05d1\u05d6\u05de\u05df \u05d0\u05de\u05ea"
    },
    "enable_smart_focus": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05e4\u05e2\u05dc \u05de\u05e0\u05d5\u05e2 Smart Focus"
    },
    "max_focus_items": {
      "type": "number",
      "default": 5,
      "description": "\u05de\u05e1\u05e4\u05e8 \u05de\u05e7\u05e1\u05d9\u05de\u05dc\u05d9 \u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05d1-Smart Focus"
    }
  },
  "required": []
}