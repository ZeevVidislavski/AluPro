{
  "name": "MaterialOrder",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8"
    },
    "project_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8"
    },
    "order_type": {
      "type": "string",
      "enum": [
        "profiles",
        "hardware",
        "glass"
      ],
      "enumLabels": [
        "\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc\u05d9\u05dd",
        "\u05e4\u05e8\u05d6\u05d5\u05dc",
        "\u05d6\u05db\u05d5\u05db\u05d9\u05ea"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d6\u05de\u05e0\u05ea \u05d7\u05d5\u05de\u05e8"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "received"
      ],
      "enumLabels": [
        "\u05d8\u05d9\u05d5\u05d8\u05d4",
        "\u05e0\u05e9\u05dc\u05d7",
        "\u05d4\u05ea\u05e7\u05d1\u05dc"
      ],
      "default": "draft",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d6\u05de\u05e0\u05d4"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "project_id",
    "order_type"
  ]
}