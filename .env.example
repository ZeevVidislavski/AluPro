# Copy to .env.local for local dev, or set as Environment Variables in Vercel project settings.

# Required — Supabase (see src/lib/supabaseClient.js). Get these from
# Supabase project settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Not required. Base44 credentials are unavailable for this project (see
# docs/PHASE_2_IMPLEMENTATION_PLAN.md) — leaving these unset is expected
# and safe. Screens still backed by Base44 will show expected 404s until
# fully migrated to Supabase; this does not block the build or the
# already-migrated screens.
# VITE_BASE44_APP_ID=
# VITE_BASE44_APP_BASE_URL=
